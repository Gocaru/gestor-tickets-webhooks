{
  "name": "server-main",
  "version": "1.0.0",
  "description": "Servidor principal para a gestão de tickets",
  "keywords": [
    "javascript",
    "tickets",
    "webhook"
  ],
  "homepage": "https://github.com/Gocaru/gestor-tickets-webhooks#readme",
  "bugs": {
    "url": "https://github.com/Gocaru/gestor-tickets-webhooks/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gocaru/gestor-tickets-webhooks.git"
  },
  "license": "ISC",
  "author": "Gonçalo Russo, Larissa Silva, Filipa Veiga, Filipe Nunes",
  "type": "module",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "node --watch src/app.js",
    "test": "node --experimental-vm-modules node_modules/.bin/jest --runInBand",
    "import:csv": "node src/scripts/importCsv.js"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "testPathIgnorePatterns": ["/node_modules/", "/gestor-tickets-webhooks/"   ]
  },
  "dependencies": {
    "better-sqlite3": "^12.6.2",
    "cors": "^2.8.6",
    "csv-parser": "^3.2.0",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "jest": "^30.3.0",
    "supertest": "^7.2.2"
  }
}
